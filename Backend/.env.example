# ─── Cognitive Mirror Backend ─── #
# Copy this file to Backend/.env and fill in real values.
# Backend/.env is gitignored. NEVER commit real keys.

# ─── Environment ───
# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── LLM Provider (model-agnostic — AI Thesis §26) ───
# Supported: openai | nvidia | anthropic
# `openai` + LLM_BASE_URL talks to any OpenAI-compatible server. Default below is
# GLM-5.3 on NVIDIA's free endpoint (build.nvidia.com).
LLM_PROVIDER=openai
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL_NAME=z-ai/glm-5.3
# Routing, reranking: high volume, low stakes (cost control, Risk 6)
LLM_MODEL_NAME_FAST=z-ai/glm-5.3-flash
# Server-side only. This key must never appear in Frontend/ code.
LLM_API_KEY=
# No LLM_API_KEY? The first of these that is set is used instead, over that
# vendor's OpenAI-compatible endpoint (presets in Backend/ai/config.py).
# Order: NVIDIA, Groq, Gemini, OpenAI. LLM_MODEL_NAME still pins the model.
NVIDIA_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Reasoning models think before answering; the fast model always has it off.
LLM_REASONING=true
LLM_TIMEOUT_SECONDS=120

# ─── Retrieval grounding (ARC) ───
# Evidence review is grounded in approved Capability Spine rubrics.
# With this off, every review is ungrounded and forced to human review.
RAG_ENABLED=true

# Embeddings for the dense retrieval arm.
#   jina | openai | voyage | local
# NOTE: hosted providers receive workplace evidence text. That needs to be in
# your DPA and works-council disclosure before a regulated client accepts it.
# `local` keeps everything in-house (needs sentence-transformers).
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v4
JINA_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# Reranking: the largest single quality lever in the ARC benchmark
# (Recall@5 0.917 -> 0.960). RERANK_PROVIDER is tried first, then every other
# keyed provider, then a listwise LLM reranker.
RERANK_PROVIDER=jina
RERANK_MODEL=jina-reranker-v2-base-multilingual
COHERE_RERANK_MODEL=rerank-v3.5
COHERE_API_KEY=

# Rubric clauses packed into the review prompt. Three are reserved for the
# capability's definition and its two evidence rubrics, which are fetched by
# key and never depend on retrieval quality.
RAG_RUBRIC_PASSAGES=7

# ─── Firebase ───
FIREBASE_PROJECT_ID=cognitive-mirror-im
# Optional. ID-token verification works WITHOUT a service account (it needs only
# the project id and Google's public certs). A service account is needed only
# for Firebase admin APIs such as user management. Path is gitignored.
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Security ───
# Accepts ID tokens WITHOUT verifying their signature. Local development only;
# the app refuses to start with this enabled unless ENVIRONMENT=development.
ALLOW_INSECURE_TOKEN_FALLBACK=false

# ─── Demo mode ───
# Presenter tooling: Apex demo tenant, one-click reset, persona switching
# (X-Demo-Persona-Email), and the verified golden AI cache. Unset = on in
# development, off elsewhere. The app refuses DEMO_MODE=true outside development.
# DEMO_MODE=
# Live-call ceiling for canonical demo inputs (they have a verified fallback).
DEMO_LLM_TIMEOUT_SECONDS=8
DEMO_INFERENCE_DELAY_SECONDS=1.2
# Optional: prebuild retrieval during startup. Leave false for faster local boot;
# the index will be built lazily on the first retrieval request.
DEMO_WARM_INDEX=false

# ─── Database ───
# SQLite for development. A relative path resolves against Backend/, whatever
# directory the server is started from.
DATABASE_URL=sqlite+aiosqlite:///./cognitive_mirror.db
# Production: postgresql+asyncpg://user:pass@host:5432/cognitive_mirror

# ─── Application ───
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─── AI Defaults ───
AI_DEFAULT_TEMPERATURE=0.1
# Reasoning models spend tokens thinking before answering; 2048 truncates them.
AI_MAX_TOKENS=8192
