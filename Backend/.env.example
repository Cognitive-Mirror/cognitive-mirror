# ─── Cognitive Mirror Backend ─── #
# Copy this file to .env and fill in the values.

# ─── LLM Provider ───
LLM_PROVIDER=nvidia
LLM_MODEL_NAME=meta/llama-3.1-70b-instruct
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx

# ─── Database (Phase 5) ───
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cognitive_mirror

# ─── Application ───
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─── AI Defaults ───
AI_DEFAULT_TEMPERATURE=0.1
AI_MAX_TOKENS=2048
