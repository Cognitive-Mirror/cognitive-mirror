# ─── Cognitive Mirror Backend ─── #
# Copy this file to Backend/.env and fill in real values.
# Backend/.env is gitignored. NEVER commit real keys.

# ─── Environment ───
# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── LLM Provider (model-agnostic — AI Thesis §26) ───
# Supported: nvidia | openai | anthropic
LLM_PROVIDER=nvidia
LLM_MODEL_NAME=meta/llama-3.1-70b-instruct
# Smaller model for high-volume, low-stakes calls (cost control, Risk 6)
LLM_MODEL_NAME_FAST=meta/llama-3.1-8b-instruct
# Server-side only. This key must never appear in Frontend/ code.
# For NVIDIA (build.nvidia.com) put your nvapi-... key here.
LLM_API_KEY=

# ─── Retrieval grounding (ARC) ───
# Evidence review is grounded in approved Capability Spine rubrics.
# With this off, every review is ungrounded and forced to human review.
RAG_ENABLED=true

# Embeddings for the dense retrieval arm.
#   openai | voyage | local
# NOTE: openai/voyage send workplace evidence text to a third party. That needs
# to be in your DPA and works-council disclosure before a regulated client
# accepts it. `local` keeps everything in-house (needs sentence-transformers).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
OPENAI_API_KEY=
VOYAGE_API_KEY=

# Reranking. The largest single quality lever in the ARC benchmark
# (Recall@5 0.917 -> 0.960). Without a Cohere key this falls back to a listwise
# LLM reranker, which works but hit a token ceiling on 15% of calls in testing.
RERANK_MODEL=rerank-v3.5
COHERE_API_KEY=

# Rubric clauses packed into the review prompt. Three are reserved for the
# capability's definition and its two evidence rubrics, which are fetched by
# key and never depend on retrieval quality.
RAG_RUBRIC_PASSAGES=7

# ─── Firebase ───
FIREBASE_PROJECT_ID=cognitive-mirror-im
# Absolute or relative path to the service account JSON (gitignored).
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Security ───
# Accepts ID tokens WITHOUT verifying their signature. Local development only;
# the app refuses to start with this enabled unless ENVIRONMENT=development.
ALLOW_INSECURE_TOKEN_FALLBACK=false

# ─── Database (Phase 5 — not yet implemented) ───
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cognitive_mirror

# ─── Application ───
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─── AI Defaults ───
AI_DEFAULT_TEMPERATURE=0.1
AI_MAX_TOKENS=2048
