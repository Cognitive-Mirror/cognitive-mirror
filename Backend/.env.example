# ─── Cognitive Mirror Backend ─── #
# Copy this file to Backend/.env and fill in real values.
# Backend/.env is gitignored. NEVER commit real keys.

# ─── Environment ───
# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── LLM Provider (model-agnostic — AI Thesis §26) ───
# Supported: nvidia | openai | anthropic
LLM_PROVIDER=nvidia
LLM_MODEL_NAME=meta/llama-3.1-70b-instruct
# Smaller model for high-volume, low-stakes calls (cost control, Risk 6)
LLM_MODEL_NAME_FAST=meta/llama-3.1-8b-instruct
# Server-side only. This key must never appear in Frontend/ code.
LLM_API_KEY=

# ─── Firebase ───
FIREBASE_PROJECT_ID=cognitive-mirror-im
# Absolute or relative path to the service account JSON (gitignored).
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Security ───
# Accepts ID tokens WITHOUT verifying their signature. Local development only;
# the app refuses to start with this enabled unless ENVIRONMENT=development.
ALLOW_INSECURE_TOKEN_FALLBACK=false

# ─── Database (Phase 5 — not yet implemented) ───
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cognitive_mirror

# ─── Application ───
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─── AI Defaults ───
AI_DEFAULT_TEMPERATURE=0.1
AI_MAX_TOKENS=2048
