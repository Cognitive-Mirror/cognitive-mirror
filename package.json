{
  "name": "cognitive-mirror",
  "version": "1.0.0",
  "description": "AI-powered Capability Intelligence Platform — dev runner for the Frontend and Backend workspaces",
  "private": true,
  "scripts": {
    "frontend": "npm --prefix Frontend run dev",
    "backend": "python -m uvicorn main:app --app-dir Backend --port 8100 --reload --reload-dir Backend",
    "dev": "concurrently -k --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,magenta\" \"npm:backend\" \"npm:frontend\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cognitive-Mirror/cognitive-mirror.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Cognitive-Mirror/cognitive-mirror/issues"
  },
  "homepage": "https://github.com/Cognitive-Mirror/cognitive-mirror#readme",
  "dependencies": {
    "concurrently": "^10.0.4"
  }
}
